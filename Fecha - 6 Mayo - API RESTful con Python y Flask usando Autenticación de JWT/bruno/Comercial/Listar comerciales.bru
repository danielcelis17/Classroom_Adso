meta {
  name: Listar comerciales
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/comercial
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
}

script:post-response {
  // La API no devuelve el id al crear: se toma el del último registro (posición 0 de cada fila)
  const filas = res.body.comerciales;
  bru.setVar("comercialId", filas[filas.length - 1][0]);
}
