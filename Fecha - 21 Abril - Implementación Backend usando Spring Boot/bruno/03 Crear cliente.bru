meta {
  name: Crear cliente
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/cliente
  body: json
  auth: none
}

body:json {
  {
    "nombre": "Ana",
    "apellido1": "Pérez",
    "apellido2": "Ríos",
    "ciudad": "Bogotá",
    "categoria": 150
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  bru.setVar("clienteId", res.body.id);
}
