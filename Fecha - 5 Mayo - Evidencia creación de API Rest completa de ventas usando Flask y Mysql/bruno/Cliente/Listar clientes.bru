meta {
  name: Listar clientes
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/cliente
  body: none
  auth: none
}

assert {
  res.status: eq 200
}

script:post-response {
  // La API no devuelve el id al crear: se toma el del último registro (posición 0 de cada fila)
  const filas = res.body.clientes;
  bru.setVar("clienteId", filas[filas.length - 1][0]);
}
