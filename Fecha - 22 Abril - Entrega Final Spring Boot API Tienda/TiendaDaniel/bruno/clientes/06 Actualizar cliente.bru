meta {
  name: Actualizar cliente
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/api/cliente/{{clienteId}}
  body: json
  auth: none
}

body:json {
  {
    "tipoDocumento": "CC",
    "numeroDocumento": "1098765432",
    "nombre": "Daniel Steven",
    "apellido": "Celis Paredes",
    "telefono": "3009876543",
    "email": "daniel.celis@correo.com",
    "direccion": "Calle 26 # 50-20",
    "ciudad": "Medellín"
  }
}

assert {
  res.status: eq 200
  res.body.ciudad: eq Medellín
}
