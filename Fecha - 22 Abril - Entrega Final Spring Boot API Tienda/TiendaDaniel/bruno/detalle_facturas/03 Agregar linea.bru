meta {
  name: Agregar linea
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/api/detalle-factura
  body: json
  auth: none
}

body:json {
  {
    "facturaId": 1,
    "productoId": 1,
    "cantidad": 1
  }
}

assert {
  res.status: eq 201
  res.body.precioVenta: eq 85000
  res.body.subtotalLinea: eq 85000
}

script:post-response {
  bru.setVar("detalleId", res.body.detalleId);
}
