meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/login
  body: json
  auth: none
}

body:json {
  {
    "username": "admin",
    "password": "admin123"
  }
}

assert {
  res.status: eq 200
  res.body.token: startsWith Bearer
}

script:post-response {
  // La guía pide copiar el token sin la palabra "Bearer"
  bru.setVar("token", res.body.token.replace("Bearer ", ""));
}
