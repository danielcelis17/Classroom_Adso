meta {
  name: Obtener token
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/token/
  body: json
  auth: none
}

body:json {
  {
    "username": "{{username}}",
    "password": "{{password}}"
  }
}

script:post-response {
  // Guarda los tokens para usarlos en las demás peticiones
  if (res.status === 200) {
    bru.setEnvVar("accessToken", res.body.access);
    bru.setEnvVar("refreshToken", res.body.refresh);
  }
}
